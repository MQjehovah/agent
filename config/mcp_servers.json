[
    {
        "name": "default",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/default.py"
        ],
        "env": {
            "SMTP_HOST": "smtp.qiye.aliyun.com",
            "SMTP_PORT": "465",
            "SMTP_USERNAME": "shuzizhongtai@xzrobot.com",
            "SMTP_PASSWORD": "${SMTP_PASSWORD}",
            "SMTP_FROM_NAME": "数字中台"
        },
        "description": "默认MCP服务 - 数据库查询和邮件发送"
    },
    {
        "name": "dingtalk",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/dingtalk.py"
        ],
        "env": {
            "DINGTALK_APP_KEY": "ding3xmu1gbsy11jbks3",
            "DINGTALK_AGENT_ID": "4389947271",
            "DINGTALK_ROBOT_CODE": "ding3xmu1gbsy11jbks3"
        },
        "description": "钉钉消息推送服务 - 支持工作通知、机器人单聊/群聊消息、Webhook、通讯录查询等"
    },
    {
        "name": "mysql_query",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mysql_query.py"
        ],
        "env": {},
        "description": "MySQL查询服务"
    },
    {
        "name": "rosiwit_cloud_remote",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/rosiwit_cloud_remote.py"
        ],
        "env": {
            "DEVICE_API_USERNAME": "rosiwit_robot",
            "DEVICE_API_PASSWORD": "${DEVICE_API_PASSWORD}"
        },
        "description": "设备远程控制（rosiwit-cloud /remote/*，含影子/录包/控制/地图/任务等）"
    },
    {
        "name": "remote_terminal",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/remote_terminal.py"
        ],
        "env": {
            "WS_BASE_URL": "wss://dev.xzrobot.com:10000"
        },
        "description": "WebSocket终端交互服务 - 通过WebSocket连接设备终端并执行命令"
    },
    {
        "name": "rosiwit_cloud_ticket",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/rosiwit_cloud_ticket.py"
        ],
        "env": {
            "DEVICE_API_USERNAME": "rosiwit_robot",
            "DEVICE_API_PASSWORD": "${DEVICE_API_PASSWORD}"
        },
        "description": "BMS工单 CRUD（rosiwit-cloud /ticket/*）"
    },
    {
        "name": "time",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_time.py"
        ],
        "env": {},
        "description": "时区时间服务（纯离线）- 当前时间/时区换算/时区名查询"
    },
    {
        "name": "fetch",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_fetch.py"
        ],
        "env": {
            "MCP_FETCH_TIMEOUT": "20",
            "MCP_FETCH_MAX_BYTES": "2097152",
            "MCP_FETCH_ALLOW_HOSTS": ""
        },
        "description": "网页抓取服务（只读+出网）- URL 转纯文本/Markdown 与 JSON 获取；私有/环回/链路本地/保留地址一律拒绝，内网指定主机需加入 MCP_FETCH_ALLOW_HOSTS 逗号白名单"
    },
    {
        "name": "filesystem",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_filesystem.py"
        ],
        "env": {
            "FS_MCP_ROOTS": "",
            "FS_MCP_ALLOW_WRITE": "false"
        },
        "description": "受限目录文件服务（默认禁用）- 目录/读取/检索/写入；启用需设置 FS_MCP_ROOTS 为允许的绝对路径(逗号分隔)并将 enabled 改为 true；写操作另需 FS_MCP_ALLOW_WRITE=true"
    }
]
