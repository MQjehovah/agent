[
    {
        "name": "default",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/default.py"
        ],
        "env": {
            "SMTP_HOST": "smtp.qiye.aliyun.com",
            "SMTP_PORT": "465",
            "SMTP_USERNAME": "shuzizhongtai@xzrobot.com",
            "SMTP_PASSWORD": "${SMTP_PASSWORD}",
            "SMTP_FROM_NAME": "数字中台"
        },
        "description": "默认MCP服务 - 数据库查询和邮件发送"
    },
    {
        "name": "dingtalk",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/dingtalk.py"
        ],
        "env": {
            "DINGTALK_APP_KEY": "ding3xmu1gbsy11jbks3",
            "DINGTALK_AGENT_ID": "4389947271",
            "DINGTALK_ROBOT_CODE": "ding3xmu1gbsy11jbks3"
        },
        "description": "钉钉消息推送服务 - 支持工作通知、机器人单聊/群聊消息、Webhook、通讯录查询等"
    },
    {
        "name": "mysql_query",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mysql_query.py"
        ],
        "env": {},
        "description": "MySQL查询服务"
    },
    {
        "name": "rosiwit_cloud_remote",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/rosiwit_cloud_remote.py"
        ],
        "env": {
            "DEVICE_API_USERNAME": "rosiwit_robot",
            "DEVICE_API_PASSWORD": "${DEVICE_API_PASSWORD}"
        },
        "description": "设备远程控制（rosiwit-cloud /remote/*，含影子/录包/控制/地图/任务等）"
    },
    {
        "name": "remote_terminal",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/remote_terminal.py"
        ],
        "env": {
            "WS_BASE_URL": "wss://dev.xzrobot.com:10000"
        },
        "timeout_seconds": 300,
        "description": "WebSocket终端交互服务 - 通过WebSocket连接设备终端并执行命令（交互命令较慢, 工具调用超时放宽到 300s）"
    },
    {
        "name": "rosiwit_cloud_ticket",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/rosiwit_cloud_ticket.py"
        ],
        "env": {
            "DEVICE_API_USERNAME": "rosiwit_robot",
            "DEVICE_API_PASSWORD": "${DEVICE_API_PASSWORD}"
        },
        "description": "BMS工单 CRUD（rosiwit-cloud /ticket/*）"
    },
    {
        "name": "time",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_time.py"
        ],
        "env": {},
        "description": "时区时间服务（纯离线）- 当前时间/时区换算/时区名查询"
    },
    {
        "name": "fetch",
        "enabled": true,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_fetch.py"
        ],
        "env": {
            "MCP_FETCH_TIMEOUT": "20",
            "MCP_FETCH_MAX_BYTES": "2097152",
            "MCP_FETCH_ALLOW_HOSTS": ""
        },
        "description": "网页抓取服务（只读+出网）- URL 转纯文本/Markdown 与 JSON 获取；私有/环回/链路本地/保留/CGNAT(100.64.0.0/10) 地址一律拒绝，内网指定主机需加入 MCP_FETCH_ALLOW_HOSTS 逗号白名单；不强制 robots.txt，企业部署建议用白名单限定目标"
    },
    {
        "name": "filesystem",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_filesystem.py"
        ],
        "env": {
            "FS_MCP_ROOTS": "",
            "FS_MCP_ALLOW_WRITE": "false",
            "FS_MCP_MAX_WRITE_BYTES": "1048576",
            "FS_MCP_ALLOW_SUFFIXES": ""
        },
        "description": "受限目录文件服务（默认禁用）- 目录/读取/检索/写入；启用需设置 FS_MCP_ROOTS 为允许的绝对路径(逗号分隔)并将 enabled 改为 true；写操作另需 FS_MCP_ALLOW_WRITE=true，可用 FS_MCP_MAX_WRITE_BYTES(默认1MB)与 FS_MCP_ALLOW_SUFFIXES(空=全允许)限制写入；删除/移动符号链接只作用于链接本身"
    },
    {
        "name": "git",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_git.py"
        ],
        "env": {
            "GIT_MCP_ROOTS": "",
            "GIT_MCP_ALLOW_WRITE": "false"
        },
        "description": "受限 Git 仓库服务（默认禁用，只读为主）- status/log/diff/show/blame/branches 与写操作 add/commit/checkout/branch；启用需将 enabled 改为 true 并设置 GIT_MCP_ROOTS 为允许的仓库根目录绝对路径(逗号分隔，空=不可用)；写操作另需 GIT_MCP_ALLOW_WRITE=true，风险由操作人承担"
    },
    {
        "name": "postgres",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/mcp_postgres.py"
        ],
        "env": {
            "PG_MCP_DSN": "${PG_MCP_DSN}",
            "PG_MCP_STATEMENT_TIMEOUT_MS": "10000",
            "PG_MCP_MAX_ROWS": "200"
        },
        "description": "PostgreSQL 只读查询服务（默认禁用）- 单条 SELECT/WITH/EXPLAIN/SHOW/VALUES 查询与表结构查看；启用需将 enabled 改为 true 并在 .env 配置 PG_MCP_DSN；连接强制只读事务+语句超时+返回行数上限（默认 200，上限 1000）"
    },
    {
        "name": "gerrit",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/gerrit.py"
        ],
        "env": {
            "GERRIT_USERNAME": "s_software",
            "GERRIT_HTTP_PASSWORD": ""
        },
        "description": "Gerrit 代码评审（变更/评审/仓库查询）—— 启用前在 .env 配置 GERRIT_HTTP_PASSWORD（可选 GERRIT_URL/GERRIT_USERNAME）"
    },
    {
        "name": "gitlab",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/gitlab.py"
        ],
        "env": {
            "GITLAB_USERNAME": "s_software",
            "GITLAB_TOKEN": ""
        },
        "description": "GitLab DevOps（项目/MR/流水线/Issue）—— 启用前在 .env 配置 GITLAB_TOKEN 或 GITLAB_PASSWORD（可选 GITLAB_URL/GITLAB_USERNAME）"
    },
    {
        "name": "jira",
        "enabled": false,
        "command": "python",
        "args": [
            "mcp_server/src/jira.py"
        ],
        "env": {
            "JIRA_USERNAME": "s_software",
            "JIRA_TOKEN": ""
        },
        "description": "Jira 研发管理（Issue/评论/查询）—— 启用前在 .env 配置 JIRA_TOKEN 或 JIRA_PASSWORD（可选 JIRA_URL/JIRA_USERNAME）"
    }
]