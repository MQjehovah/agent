# 主进程启动时加载（见 electron/main/load-env.ts）；仅补缺失，不覆盖已存在的环境变量。
# 复制为 .env 并填写；.env 已在 .gitignore，勿提交真实凭据。

# ---- agent 凭据（JIT 开号/登录用，至少配一项）----
# 优先：服务间专用令牌（与 agent 的 AGENT_SERVICE_TOKEN 一致）
AGENT_SERVICE_TOKEN=
# 回退：agent 管理员账号（与 agent 侧 AGENT_ADMIN_USER/AGENT_ADMIN_PASSWORD 一致）
AGENT_ADMIN_USER=admin
AGENT_ADMIN_PASSWORD=

# ---- 服务地址（默认指向 https://ai.xzrobot.com，内网可覆盖）----
# AGENT_URL=https://ai.xzrobot.com/agent
# RAG_URL=https://ai.xzrobot.com/rag
# MARKET_URL=https://ai.xzrobot.com/market
# ROUTER_URL=https://ai.xzrobot.com/router
# ROUTER_ADMIN_URL=https://ai.xzrobot.com/router

# ---- 企业 SSO(OIDC) ----
# OIDC_ISSUER=https://auth.xzrobot.com
# OIDC_CLIENT_ID=dashboard-gateway
# OIDC_CLIENT_SECRET=
