# ===== Agent 环境变量模板 =====
# 复制为 .env 并填写真实值(.env 已被 .gitignore 忽略, 切勿提交)
#
# 运行环境: production/prod(大小写不敏感)下缺失或弱 secret 将拒绝启动; 默认 development
APP_ENV=development

# Web 登录 JWT 密钥; 生产必填(缺失/弱值拒绝启动); 开发留空时回退 config/jwt_secret 自动生成
# JWT_SECRET=change-me

# 首次初始化 admin 口令; 生产必填(未配置拒绝启动); 开发留空时随机生成并仅打印一次
# AGENT_ADMIN_PASSWORD=change-me

# MCP 子进程凭证(config/mcp_servers.json 中以 ${...} 占位符引用; 真实值不入版本库)
SMTP_PASSWORD=change-me
DEVICE_API_PASSWORD=change-me

# MCP 数据库/设备终端口令(mcp_server 子进程读取; 生产缺失/弱值拒绝启动)
DB_PASSWORD=change-me
TERM_PASSWORD=change-me

# IT 运维技能脚本口令(如 GitLab 合并; 生产缺失/弱值拒绝启动)
IT_SYSTEM_PASSWORD=change-me

# 钉钉应用凭证(钉钉开放平台企业内部应用; 变量名与 mcp_server/src/dingtalk.py 一致)
# 优先于 config/plugins/dingtalk.json, 密钥不入版本库
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me

# 飞书应用凭证(飞书开放平台)
FEISHU_APP_ID=change-me
FEISHU_APP_SECRET=change-me

# Web 登录会话(agent JWT)有效期(秒); 默认 43200(12h), 非法值回退默认
AGENT_SESSION_TTL_SECONDS=43200
