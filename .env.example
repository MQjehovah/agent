# ===== Agent 环境变量模板 =====
# 复制为 .env 并填写真实值(.env 已被 .gitignore 忽略, 切勿提交)
#
# 运行环境: production/prod(大小写不敏感)下缺失或弱 secret 将拒绝启动; 默认 development
APP_ENV=development

# Web 登录 JWT 密钥; 生产必填(缺失/弱值拒绝启动); 开发留空时回退 config/jwt_secret 自动生成
# JWT_SECRET=change-me

# 首次初始化 admin 口令; 生产必填(未配置拒绝启动); 开发留空时随机生成并仅打印一次
# AGENT_ADMIN_PASSWORD=change-me

# MCP 子进程凭证(config/mcp_servers.json 中以 ${...} 占位符引用; 真实值不入版本库)
SMTP_PASSWORD=change-me
DEVICE_API_PASSWORD=change-me

# MCP 数据库/设备终端口令(mcp_server 子进程读取; 生产缺失/弱值拒绝启动)
DB_PASSWORD=change-me
TERM_PASSWORD=change-me

# ===== LLM 端点(推荐用环境变量注入密钥, config/config.json 只留结构) =====
# 优先级: 环境变量 > config/config.json > 默认值
# 单端点: 覆盖 config.json 第 1 个端点的 base_url/model/api_key(缺省项沿用文件值)
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-flash
# 多端点/多密钥: 传 JSON 数组, 整体替换 llm.endpoints
# LLM_ENDPOINTS_JSON=[{"model":"m1","base_url":"https://a/v1","api_key":"k1"}]

# ===== 市场平台 MCP 轨(可选; MARKET_BASE_URL 与 MARKET_SERVICE_TOKEN 齐备才启用) =====
# 市场能力目录 sync + 能力级网关 /relay 直连(Streamable HTTP); 缺失=功能关闭, 仅本地 MCP
# MARKET_BASE_URL=https://market.example.com
# 市场服务令牌(绑定账号需有运行时准入, 生产用 admin 账号绑定; 令牌不落日志)
# MARKET_SERVICE_TOKEN=change-me
# 目录刷新周期(秒, 默认 300)与同步/连接/调用超时(秒, 默认 60); 非法值回退默认
# MARKET_PLATFORM_REFRESH_SECONDS=300
# MARKET_PLATFORM_TIMEOUT=60
# 按用户身份(act-as): 1/true/yes 开, 0/false/no 关(缺省关; 其它非空值告警按关);
# 仅 web 渠道 worker 池启用(AGENT_WEB_POOL_SIZE>0)时生效, 钉钉/飞书等 root 渠道不变,
# 每 worker 以该用户的市场用户名(= rbac 工号)请求 X-Act-As-Sub(sync 只回其可见能力,
# relay 按其门禁/限流/密钥注入); 解析失败回退服务令牌视角并告警。关=root 服务令牌全量。
# MARKET_ACT_AS=1

# 本地 MCP 与平台轨取舍(AGENT_MCP_LOCAL_MODE):
#   market(默认)=市场优先: 平台轨启用则不连本地 MCP(避免与平台能力重复); 平台未启用或首轮 0 可用能力→自动兜底连本地
#   both=本地 + 平台并存(旧行为); local=仅本地(不挂平台轨)
# 市场故障时可临时设 both 或 local 并重启作为兜底。
# AGENT_MCP_LOCAL_MODE=market

# 本地专家/技能取舍(AGENT_LOCAL_EXPERTS_MODE):
#   market(默认)=专家/技能收口到市场: 根 agent 仅保留本地团队(AI开发团队), 其余专家走 market_delegate;
#                 不加载本地顶层 config/skills(技能经市场文本注入/委派)
#   both=本地专家+技能 与 市场并存; local=仅本地(不依赖市场专家)
# AGENT_LOCAL_EXPERTS_MODE=market

# IT 运维技能脚本口令(如 GitLab 合并; 生产缺失/弱值拒绝启动)
IT_SYSTEM_PASSWORD=change-me

# 钉钉应用凭证(钉钉开放平台企业内部应用; 变量名与 mcp_server/src/dingtalk.py 一致)
# 优先于 config/plugins/dingtalk.json, 密钥不入版本库
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me

# 飞书应用凭证(飞书开放平台)
FEISHU_APP_ID=change-me
FEISHU_APP_SECRET=change-me

# Web 登录会话(agent JWT)有效期(秒); 默认 43200(12h), 非法值回退默认
AGENT_SESSION_TTL_SECONDS=43200

# ===== 企业 SSO(OIDC) =====
# 资源轨: 接受别的系统(工作台)传来的 SSO token 时校验 issuer/受众(不配则 SSO 轨禁用)
# SSO_ISSUER=https://auth.xzrobot.com
# SSO_AUDIENCE=agent
# 容器内解析不到公网域名时, JWKS 直连内网地址, 避免走公网(DNS 受限时必配)
# SSO_JWKS_URI=http://192.168.31.45:8091/.well-known/jwks.json

# 登录轨: 浏览器「企业 SSO 登录」(授权码流程), client_id + redirect_uri 配齐后 /api/auth/sso/start 可用
# SSO_CLIENT_ID=agent
# SSO_CLIENT_SECRET=change-me
# SSO_REDIRECT_URI=https://ai.xzrobot.com/agent/api/auth/sso/callback
# 回调后跳回的前端地址(子路径+hash 路由部署时为 /agent/#/login)
# SSO_REDIRECT_TARGET=/agent/#/login

# 服务间凭证: 网关/工作台等可信服务用 X-Service-Token 免登录调用(自动开号等)
# 留空则关闭该通道; 该令牌在 agent 侧等同管理员身份, 务必只下发给可信服务
# AGENT_SERVICE_TOKEN=change-me

# ===== DevOps MCP(gitlab/gerrit/jira 自研 server, 默认未挂载; 见 mcp_server/README.md) =====
# GitLab: 优先 PAT(GITLAB_TOKEN, PRIVATE-TOKEN 头); 无 PAT 时用 LDAP 会话登录(密码可回退 IT_SYSTEM_PASSWORD)
# GITLAB_TOKEN=glpat-xxxxxxxx
# GITLAB_USERNAME=s_software
# Gerrit: HTTP Credentials 生成的 HTTP 口令(不是 LDAP 密码); 留空=匿名只读, 写操作不可用
# GERRIT_USERNAME=s_software
# GERRIT_HTTP_PASSWORD=change-me
# Jira(Server/DC): 优先 PAT(JIRA_TOKEN, Bearer); 否则 Basic(密码可回退 IT_SYSTEM_PASSWORD)
# JIRA_TOKEN=xxxxxxxx
# JIRA_USERNAME=s_software

# ===== 渐进披露(工具搜索): 远程工具多时先发核心工具 + search_tools, 命中激活后下一轮可调用 =====
# off=全量; always=总是渐进; auto=远程工具数 > 阈值时渐进(默认)
# AGENT_TOOL_SEARCH=auto
# 远程工具数超过该阈值时 auto 触发渐进(默认 40; 非法值回退默认)
# AGENT_TOOL_SEARCH_THRESHOLD=40
