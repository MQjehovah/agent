# Copy to .env and fill in. Never commit real secrets.

# ── LLM ──
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 云端账号 + 远程终端（BMS 按钮不用传地址，只传 ticket_id）──
DEVICE_API_USERNAME=rosiwit_robot
DEVICE_API_PASSWORD=
TICKET_API_USERNAME=
TICKET_API_PASSWORD=
WS_BASE_URL=wss://dev.xzrobot.com:10000

